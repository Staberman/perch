---
import "../styles/global.css";
import { moodCards } from "../data/moods.ts";
import { perch, sections, site } from "../data/site.ts";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The brush font is only for a handful of decorative characters, so ask Google Fonts for just those.
const brushGlyphs = [
  perch.kanji,
  "とまり",
  ...Object.values(sections).flatMap((s) => [s.numeral, s.kanji]),
  ...moodCards.map((m) => m.kanji),
].join("");
const brushText = encodeURIComponent([...new Set(brushGlyphs)].join(""));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f3eb" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Shippori+Mincho:wght@500;600;700&family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
    />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=Yuji+Syuku&text=${brushText}&display=swap`} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { revealOnScroll } from "../lib/reveal.ts";
      revealOnScroll();
    </script>
  </body>
</html>
