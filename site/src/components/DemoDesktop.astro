---
import { statusLine } from "../domain/appearance.ts";
import { demoSessions } from "../data/demo.ts";
import Creature from "./Creature.astro";

const [front] = demoSessions;
const chevron = ["...X", "..XX", ".XX.", "XX..", ".XX.", "..XX", "...X"];
---

<tomari-demo class="mac" role="img" aria-label="A Mac desktop with Tomari's strip of creatures on its right edge. One session asks for permission, the cursor clicks its creature and the session opens.">
  <div class="menubar" aria-hidden="true">
    <span class="menus"><b>Claude</b><span>File</span><span>Edit</span><span>View</span><span>Window</span></span>
    <span class="status">
      <span class="menu-item" data-menu-item>
        <Creature character="default" color="#3b3640" state="idle" bare unit="0.75px" label="" />
        <span data-waiting></span>
      </span>
      <span>Thu 9:41</span>
    </span>
  </div>

  <div class="desk" data-desk aria-hidden="true">
    <div class="wallpaper">
      <span class="sun"></span>
      <svg class="hills" viewBox="0 0 600 200" preserveAspectRatio="none">
        <path d="M0 120 L80 70 L140 105 L230 40 L300 95 L360 60 L440 110 L520 55 L600 95 V200 H0Z" fill="#d9dfea"></path>
        <path d="M0 150 L70 118 L150 140 L240 100 L330 138 L410 112 L500 145 L600 120 V200 H0Z" fill="#c6d0df"></path>
        <path d="M0 175 L110 155 L220 172 L320 150 L430 170 L530 156 L600 168 V200 H0Z" fill="#b3bfd2"></path>
      </svg>
    </div>

    <div class="window">
      <div class="window-bar">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="window-title" data-title>{front?.name}</span>
      </div>
      <div class="window-body">
        <ul class="sessions">
          {
            demoSessions.map((s, i) => (
              <li data-session={s.id} class:list={{ current: i === 0 }}>
                <i class:list={["dot", s.state]} />
                <span>{s.name}</span>
              </li>
            ))
          }
        </ul>
        <div class="pane" data-pane>
          <p class="prompt">{front?.prompt}</p>
          <div class="lines"><i></i><i></i><i></i></div>
          <div class="tool"><span class="running">{front?.activity}</span></div>
        </div>
      </div>
    </div>

    <div class="strip-wrap">
      <span class="tab">
        <svg viewBox="0 0 8 21" shape-rendering="crispEdges">
          {chevron.map((row, y) => [...row].map((c, x) => c === "X" && <rect x={5 - x} y={7 + y} width="1" height="1" fill="#8b909a" />))}
        </svg>
      </span>
      <div class="strip">
        {
          demoSessions.map((s, i) => (
            <span class="cell" data-cell={s.id}>
              <Creature character={s.character} color={s.color} state={s.state} focused={i === 0} offset={i * 3} unit="var(--cell-u)" label={`${s.name}: ${statusLine(s)}`} />
            </span>
          ))
        }
        <span class="cell">
          <span class="plus">
            <svg viewBox="0 0 24 24" shape-rendering="crispEdges"><rect x="8" y="11" width="8" height="2" fill="#8b909a"></rect><rect x="11" y="8" width="2" height="8" fill="#8b909a"></rect></svg>
          </span>
        </span>
      </div>
    </div>

    <div class="label" data-label><b data-label-name></b><span data-label-status></span></div>
    <svg class="cursor" data-cursor viewBox="0 0 16 22">
      <path d="M1 1v17l4.5-4.2 3 6.7 3-1.3-3-6.6H15z" fill="#1d1b20" stroke="#fff" stroke-width="1.3" stroke-linejoin="round"></path>
    </svg>
  </div>

  <template data-view="prompt">
    <p class="prompt" data-slot="prompt"></p>
    <div class="lines"><i></i><i></i><i></i></div>
  </template>
  <template data-view="working">
    <div class="tool"><span class="running" data-slot="activity"></span></div>
  </template>
  <template data-view="ask">
    <div class="ask">
      <p data-slot="question"></p>
      <div class="choices"><span data-slot="decline"></span><span class="primary" data-slot="accept" data-answer></span></div>
    </div>
  </template>
  <template data-view="done">
    <p class="done-note">✓ Done. Waiting for your reply.</p>
  </template>
</tomari-demo>

<script>
  import "../elements/tomari-demo.ts";
</script>

<style>
  .mac {
    position: relative;
    display: block;
    border-radius: 16px;
    border: 1px solid rgba(38, 34, 43, 0.12);
    overflow: hidden;
    background: var(--card);
    box-shadow:
      0 0 0 8px rgba(255, 253, 248, 0.6),
      0 50px 100px -40px rgba(84, 52, 30, 0.45),
      0 30px 60px -40px rgba(212, 73, 44, 0.25);
  }

  .menubar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 26px;
    padding: 0 12px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(38, 34, 43, 0.06);
    font-size: 11.5px;
    color: #2b2830;
    position: relative;
    z-index: 2;
  }

  .menus,
  .status {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
  }

  .menus span {
    color: #4a4550;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 1px 5px;
    border-radius: 5px;
    transition: background 0.4s;
  }

  .menu-item [data-waiting] {
    color: var(--shu);
    font-weight: 700;
  }

  .menu-item.needy {
    background: rgba(212, 73, 44, 0.12);
  }

  .desk {
    position: relative;
    height: clamp(360px, 36vw, 450px);
    overflow: hidden;
  }

  .wallpaper {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #f6e9e4 0%, #efe6ef 45%, #e2e8f1 100%);
  }

  .sun {
    position: absolute;
    top: 14%;
    left: 22%;
    width: 120px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, #f4a28e, #e66f55);
    opacity: 0.8;
    filter: blur(0.3px);
  }

  .hills {
    position: absolute;
    inset: auto 0 0;
    width: 100%;
    height: 48%;
  }

  .window {
    position: absolute;
    top: 7%;
    left: 5%;
    right: 112px;
    bottom: 8%;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    border: 1px solid rgba(38, 34, 43, 0.1);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    box-shadow: 0 30px 60px -30px rgba(40, 30, 60, 0.4);
    overflow: hidden;
  }

  .window-bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border-bottom: 1px solid rgba(38, 34, 43, 0.07);
    font-size: 12px;
  }

  .lights {
    display: flex;
    gap: 6px;
  }

  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  .window-title {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    color: #3d3842;
    font-weight: 500;
  }

  .window-body {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  .sessions {
    flex: none;
    width: 34%;
    max-width: 168px;
    padding: 10px 8px;
    border-right: 1px solid rgba(38, 34, 43, 0.07);
    background: rgba(247, 243, 235, 0.6);
    font-size: 11.5px;
  }

  .sessions li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: 7px;
    color: #6a6370;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      background 0.4s var(--ease-out),
      color 0.4s;
  }

  .sessions li.current {
    background: rgba(38, 34, 43, 0.07);
    color: var(--ink);
  }

  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c6c0ca;
    transition: background 0.4s;
  }

  .dot.working,
  .dot.compacting {
    background: #8aa4d6;
  }

  .dot.needsPermission,
  .dot.needsInput {
    background: #ff6b1a;
    box-shadow: 0 0 0 3px rgba(255, 107, 26, 0.2);
  }

  .dot.done {
    background: #4cd964;
  }

  .pane {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    font-size: 12px;
    overflow: hidden;
  }

  .pane.switching {
    animation: switch 0.5s var(--ease-out);
  }

  @keyframes switch {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  .pane :global(.prompt) {
    align-self: flex-end;
    max-width: 85%;
    padding: 7px 12px;
    border-radius: 12px 12px 3px 12px;
    background: var(--paper-deep);
    color: var(--ink);
  }

  .pane :global(.lines) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pane :global(.lines i) {
    height: 7px;
    border-radius: 4px;
    background: rgba(38, 34, 43, 0.07);
  }

  .pane :global(.lines i:nth-child(1)) {
    width: 92%;
  }

  .pane :global(.lines i:nth-child(2)) {
    width: 76%;
  }

  .pane :global(.lines i:nth-child(3)) {
    width: 60%;
  }

  .pane :global(.tool) {
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid rgba(38, 34, 43, 0.08);
    background: #f8f6f1;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #4a4550;
  }

  .pane :global(.running::after) {
    content: "";
    display: inline-block;
    width: 6px;
    height: 11px;
    margin-left: 4px;
    vertical-align: -1px;
    background: var(--ink-2);
    animation: caret 1s steps(2) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  .pane :global(.ask) {
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 107, 26, 0.45);
    background: rgba(255, 107, 26, 0.07);
    animation: switch 0.5s var(--ease-out);
  }

  .pane :global(.ask p) {
    margin-bottom: 8px;
  }

  .pane :global(.choices) {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
  }

  .pane :global(.choices span) {
    padding: 3px 12px;
    border-radius: 7px;
    border: 1px solid rgba(38, 34, 43, 0.14);
    font-size: 11px;
    transition:
      transform 0.15s,
      filter 0.2s;
  }

  .pane :global(.choices .primary) {
    border-color: #ff6b1a;
    background: #ff6b1a;
    color: #fff;
    font-weight: 700;
  }

  .pane :global(.pressed) {
    transform: scale(0.92);
    filter: brightness(1.1);
  }

  .pane :global(.done-note) {
    color: #2f9e4a;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .strip-wrap {
    --u: 2px;
    --cell-u: var(--u);
    position: absolute;
    top: 50%;
    right: 0;
    display: flex;
    align-items: center;
    translate: 0 -50%;
  }

  .strip {
    display: flex;
    flex-direction: column;
    padding: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-right: 0;
    border-radius: 10px 0 0 10px;
    background: rgba(13, 13, 13, 0.78);
    backdrop-filter: blur(8px);
    box-shadow: -10px 20px 40px -20px rgba(20, 15, 30, 0.5);
  }

  .cell {
    display: grid;
    place-items: center;
    width: calc(28 * var(--u));
    height: calc(28 * var(--u));
  }

  .cell :global(.creature.pressed) {
    transform: scale(0.88);
  }

  .plus {
    display: grid;
    place-items: center;
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
  }

  .plus svg,
  .tab svg {
    width: calc(24 * var(--u));
    height: calc(24 * var(--u));
  }

  .tab {
    display: grid;
    place-items: center;
    width: calc(8 * var(--u));
    height: calc(21 * var(--u));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-right: 0;
    border-radius: calc(3 * var(--u)) 0 0 calc(3 * var(--u));
    background: rgba(13, 13, 13, 0.78);
  }

  .tab svg {
    width: 100%;
    height: 100%;
  }

  .label {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 6px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(13, 13, 13, 0.86);
    color: #f5f5f5;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    translate: 8px 0;
    transition:
      opacity 0.35s var(--ease-out),
      translate 0.35s var(--ease-out);
  }

  .label.shown {
    opacity: 1;
    translate: 0 0;
  }

  .label b {
    font-size: 12px;
    font-weight: 700;
  }

  .label span {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #999;
  }

  .label[data-tone="attention"] span {
    color: #ff6b1a;
  }

  .label[data-tone="ready"] span {
    color: #4cd964;
  }

  .label[data-tone="danger"] span {
    color: #ff4d4d;
  }

  .cursor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 16px;
    height: 22px;
    filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.25));
    translate: var(--x, 62%) var(--y, 78%);
    transition: translate 1.05s var(--ease-in-out);
  }

  .desk :global(.ripple) {
    position: absolute;
    z-index: 4;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border: 2px solid rgba(38, 34, 43, 0.6);
    border-radius: 50%;
    pointer-events: none;
    animation: ripple 0.6s var(--ease-out) forwards;
  }

  @keyframes ripple {
    from {
      opacity: 1;
      scale: 0.3;
    }
    to {
      opacity: 0;
      scale: 1.4;
    }
  }

  @media (max-width: 720px) {
    .desk {
      height: 330px;
    }

    .strip-wrap {
      --u: 1.5px;
    }

    .window {
      left: 4%;
      right: 88px;
    }

    .sessions,
    .menus span {
      display: none;
    }
  }
</style>
