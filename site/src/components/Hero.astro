---
import { perch, site } from "../data/site.ts";
import CopyCommand from "./CopyCommand.astro";
import DemoDesktop from "./DemoDesktop.astro";
import Hanko from "./Hanko.astro";
import Petals from "./Petals.astro";

// Each word rises into place on its own, so the headline is split here rather than by script.
const headline: { word: string; accent?: true }[] = [
  ...["Your", "Claude", "Code", "sessions,"].map((word) => ({ word })),
  { word: "perched", accent: true },
  ...["on", "the", "edge", "of", "your", "screen."].map((word) => ({ word })),
];
---

<section class="hero" id="top">
  <div class="backdrop" aria-hidden="true">
    <span class="sun"></span>
    <span class="mist mist-1"></span>
    <span class="mist mist-2"></span>
    <span class="vertical">{perch.kanji}</span>
    <Petals count={16} seed={11} />
  </div>

  <div class="container grid">
    <div class="copy">
      <p class="kicker">
        <Hanko size="38px" />
        <span><span lang="ja">{perch.kanji}</span> · <i>{perch.reading}</i>, a perch for your sessions</span>
      </p>

      <h1>
        {
          headline.map(({ word, accent }, i) => [
            <span class:list={["word", { accent }]} style={`--i: ${i}`}>
              <span>{word}</span>
              {accent && (
                <svg class="brush" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M3 13 C 40 6, 90 5, 130 9 S 185 14, 197 8" />
                </svg>
              )}
            </span>,
            " ",
          ])
        }
      </h1>

      <p class="lede">
        One pixel-art creature per session, resting on the edge of your Mac. It hops while Claude works, calls out when it needs you and holds up a check when it's done. Click it, and you're back in that session.
      </p>

      <div class="cta">
        <CopyCommand command={site.installCommand} />
        <a class="more" href="#moods">Meet the creatures <span aria-hidden="true">↓</span></a>
      </div>

      <ul class="facts">
        <li>macOS 14+</li>
        <li>Free and open source</li>
        <li>Stays on your Mac</li>
      </ul>
    </div>

    <figure class="demo">
      <DemoDesktop />
      <figcaption>A replay drawn with Tomari's own sprites: a session asks for permission, you click it and you're in.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: 140px 96px;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: clip;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 85% 10%, var(--sakura-soft), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, #e7eef3, transparent 70%),
      linear-gradient(180deg, #faf6ef, var(--paper));
  }

  .sun {
    position: absolute;
    top: 9%;
    right: 12%;
    width: clamp(220px, 32vw, 460px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 36%, #f7c2b2, #ee9a82 55%, #e67d64);
    opacity: 0.55;
    filter: blur(1px);
    animation: breathe 9s var(--ease-in-out) infinite alternate;
  }

  @keyframes breathe {
    to {
      scale: 1.04;
      opacity: 0.62;
    }
  }

  .mist {
    position: absolute;
    left: -20%;
    width: 140%;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.9), transparent);
    filter: blur(8px);
    animation: drift 26s var(--ease-in-out) infinite alternate;
  }

  .mist-1 {
    top: 34%;
  }

  .mist-2 {
    top: 62%;
    animation-duration: 34s;
    animation-direction: alternate-reverse;
    opacity: 0.8;
  }

  @keyframes drift {
    from {
      translate: -6% 0;
    }
    to {
      translate: 6% 0;
    }
  }

  .vertical {
    position: absolute;
    top: 130px;
    left: calc(var(--gutter) * 0.4);
    writing-mode: vertical-rl;
    font-family: var(--font-brush);
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    letter-spacing: 0.3em;
    color: rgba(38, 34, 43, 0.06);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--ink-2);
    font-size: 0.95rem;
    animation: rise 1.2s var(--ease-out) both;
  }

  .kicker [lang="ja"] {
    font-family: var(--font-display);
    color: var(--ink);
  }

  h1 {
    font-size: clamp(2.5rem, 4.3vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  .word {
    position: relative;
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: top;
  }

  .word > span {
    display: inline-block;
    animation: word 1.3s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 0.055s);
  }

  @keyframes word {
    from {
      translate: 0 105%;
      rotate: 4deg;
    }
  }

  .accent {
    overflow: visible;
    color: var(--shu);
  }

  .accent > span {
    clip-path: inset(0 0 -0.2em 0);
  }

  .brush {
    position: absolute;
    left: -2%;
    bottom: -0.12em;
    width: 104%;
    height: 0.32em;
    overflow: visible;
  }

  .brush path {
    fill: none;
    stroke: var(--shu);
    stroke-width: 5;
    stroke-linecap: round;
    opacity: 0.45;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: stroke 1.1s var(--ease-out) 1s forwards;
  }

  @keyframes stroke {
    to {
      stroke-dashoffset: 0;
    }
  }

  .lede {
    max-width: 33em;
    color: var(--ink-2);
    font-size: 1.12rem;
    animation: rise 1.2s var(--ease-out) 0.7s both;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 26px;
    animation: rise 1.2s var(--ease-out) 0.85s both;
  }

  .more {
    color: var(--ink-2);
    text-decoration: none;
    background: linear-gradient(var(--shu), var(--shu)) 0 100% / 0 1px no-repeat;
    transition:
      background-size 0.6s var(--ease-out),
      color 0.3s;
  }

  .more:hover {
    color: var(--ink);
    background-size: 100% 1px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    color: var(--ink-3);
    font-size: 0.9rem;
    animation: rise 1.2s var(--ease-out) 1s both;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .facts li::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--matcha);
  }

  .demo {
    margin: 0;
    min-width: 0;
    animation: float-in 1.6s var(--ease-out) 0.45s both;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      translate: 0 40px;
      scale: 0.97;
    }
  }

  figcaption {
    margin-top: 18px;
    color: var(--ink-3);
    font-size: 0.85rem;
    text-align: center;
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }

  @media (max-width: 1060px) {
    .hero {
      padding-block: 130px 72px;
      min-height: 0;
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .copy {
      align-items: center;
      text-align: center;
    }

    .cta,
    .facts {
      justify-content: center;
    }

    .demo {
      width: 100%;
      max-width: 720px;
      margin-inline: auto;
    }

    .vertical {
      display: none;
    }

    .sun {
      top: 6%;
      right: -10%;
    }
  }

  @media (max-width: 520px) {
    .kicker {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
