---
import { perch } from "../data/site.ts";
import Petals from "./Petals.astro";
---

<section class="perch" aria-labelledby="perch-title">
  <Petals count={18} seed={29} />
  <div class="copy container">
    <div class="title" data-reveal>
      <svg class="enso" viewBox="0 0 200 200" aria-hidden="true">
        <path pathLength="1" d="M150 40 C 118 14, 58 18, 34 62 C 12 104, 36 160, 92 170 C 146 180, 184 140, 178 92 C 175 70, 166 56, 156 46" />
      </svg>
      <h2 id="perch-title" lang="ja">{perch.kanji}</h2>
    </div>
    <p class="reading" data-reveal><i>{perch.reading}</i> · <span>noun</span> · {perch.meaning}</p>
    <p class="text" data-reveal>A quiet spot for every session to rest while it works, and to call you over when it's ready.</p>
  </div>
  <tomari-branch class="branch">
    <canvas role="img" aria-label="Tomari's creatures perched along a blossoming branch"></canvas>
  </tomari-branch>
</section>

<script>
  import "../elements/tomari-branch.ts";
</script>

<style>
  .perch {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(96px, 12vw, 150px);
    background:
      radial-gradient(70% 60% at 50% 100%, rgba(242, 185, 198, 0.35), transparent 70%),
      linear-gradient(180deg, var(--paper), #f8eee9 45%, #f6e7e6 78%, var(--paper));
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    position: relative;
    display: grid;
    place-items: center;
  }

  .enso {
    position: absolute;
    width: clamp(240px, 34vw, 420px);
    overflow: visible;
  }

  .enso path {
    fill: none;
    stroke: var(--shu);
    stroke-width: 9;
    stroke-linecap: round;
    opacity: 0.16;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 2.4s var(--ease-out) 0.3s;
  }

  .title:global(.is-revealed) .enso path,
  :global(html:not(.js)) .enso path {
    stroke-dashoffset: 0;
  }

  h2 {
    position: relative;
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: clamp(4.5rem, 13vw, 9.5rem);
    line-height: 1.2;
    letter-spacing: 0.04em;
    padding-block: clamp(30px, 5vw, 60px);
  }

  .reading {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--shu);
  }

  .reading span {
    color: var(--ink-3);
  }

  .text {
    max-width: 30em;
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 1.15rem;
  }

  .branch {
    display: block;
    margin-top: clamp(24px, 4vw, 52px);
  }

  .branch canvas {
    display: block;
    width: 100%;
    height: 320px;
    image-rendering: pixelated;
  }
</style>
